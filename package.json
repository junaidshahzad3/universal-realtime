{
  "name": "universal-realtime",
  "version": "1.4.0",
  "description": "Premium, lightweight, isomorphic full-stack real-time engine and hooks framework for React, Node.js, and browser environments. Features resilient WebSocket auto-reconnections, exponential backoff with jitter, offline event buffers, active pings, presence rooms, and Server-Sent Events.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "require": "./dist/client.js",
      "import": "./dist/client.mjs",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "require": "./dist/server.js",
      "import": "./dist/server.mjs",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/server.ts --format cjs,esm --dts --minify --clean --treeshake",
    "dev": "tsup src/index.ts src/server.ts --format cjs,esm --watch --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^0.34.0",
    "jsdom": "^22.1.0",
    "mock-socket": "^9.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^7.1.0",
    "tsx": "^4.11.0",
    "typescript": "^5.1.0",
    "vitest": "^0.34.0",
    "ws": "^8.17.0"
  },
  "keywords": [
    "react",
    "hooks",
    "websocket",
    "sse",
    "realtime",
    "presence",
    "optimistic-update",
    "fullstack",
    "isomorphic",
    "websocket-server",
    "heartbeat",
    "backoff-jitter",
    "offline-queue",
    "message-replay",
    "server-sent-events",
    "presence-rooms",
    "typescript",
    "nodejs"
  ],
  "author": "Junaid Shahzad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junaidshahzad3/universal-realtime.git"
  },
  "bugs": {
    "url": "https://github.com/junaidshahzad3/universal-realtime/issues"
  },
  "homepage": "https://github.com/junaidshahzad3/universal-realtime#readme"
}
